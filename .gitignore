# .gitignore for FileDir, generated by tidy on 2026-10-08.
#
# THIS IS A WHITELIST. Everything is ignored, and then exactly what
# RepoFiles.txt names is put back. A file dropped into this folder is
# invisible to git until somebody names it there, which is the point: the
# file that gets pushed by accident is always the one nobody thought of.
#
# To add a file to the repository, add one line to RepoFiles.txt and run
# tidy again. Do not edit this file by hand; it is overwritten.

# Ignore everything.
/*

# Put back what the project names.
!/.gitattributes
!/accept.inix
!/AssocOff.bas
!/AssocOn.bas
!/build.cmd
!/configs/
!/Convert.cs
!/data/
!/Dialogs.cs
!/FileDir.cs
!/FileDir.exe.config
!/FileDir.ico
!/FileDir.js
!/FileDir.manifest
!/FileDir_setup.iss
!/help/
!/License.htm
!/License.md
!/LocalFiles.txt
!/Media.cs
!/MediaPlayer.cs
!/migrateFileDir.cmd
!/Mpv.cs
!/ReadMe.htm
!/ReadMe.md
!/RepoFiles.txt
!/scripts/
!/Table.cs
!/templates/
!/.gitignore
!/.gitattributes
!/KeepEncoding.txt

# On this disk only, from LocalFiles.txt.
exec/
logs/
notes/
work/
packages/
version.txt
Version.cs
KeyText.cs
*.zip
*.exe
*.dll

# Never pushed, whatever RepoFiles.txt says: private notes, maintainer
# scripts, logs, and anything a build makes.
*.exe
*.jsb
*.log
*.obj
*.pdb
Version.cs
__pycache__/
.venv/
build/
create*Repo.cmd
create*Repo.ps1
dist/
notes/
exec/
logs/
self.htm
self.md
